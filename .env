# Copy this file to ".env" and fill in your real values.
# Never commit the real ".env" file to git.

# ---- Server ----
PORT=4000
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ---- OTP behaviour ----
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ---- SMS provider ----
# "console"  -> OTP is only printed in the backend terminal / logged to db (FREE, for local dev/demo).
# "twilio"   -> real SMS sent worldwide via Twilio (https://www.twilio.com/console).
# "msg91"    -> real SMS sent to Indian numbers via MSG91 (https://control.msg91.com), usually cheaper for India.
SMS_PROVIDER=console

# --- Twilio (only needed if SMS_PROVIDER=twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- MSG91 (only needed if SMS_PROVIDER=msg91) ---
MSG91_AUTH_KEY=
MSG91_SENDER_ID=JANSRT
MSG91_TEMPLATE_ID=

# ---- AI assistant ("Jan AI") ----
# "echo"      -> free, no account needed, but only answers a handful of preset banking topics.
# "anthropic" -> real Claude answers to ANY question, needs your own key from console.anthropic.com
# "openai"    -> real GPT answers to ANY question, needs your own key from platform.openai.com
AI_PROVIDER=echo
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
